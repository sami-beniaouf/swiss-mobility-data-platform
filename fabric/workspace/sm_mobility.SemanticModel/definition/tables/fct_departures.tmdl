table fct_departures
	lineageTag: 0e8d6d80-ce67-4da9-a1df-aca410eb018f
	sourceLineageTag: [marts].[fct_departures]

	measure Departures = COUNTROWS ( fct_departures )
		formatString: 0
		lineageTag: 786fd1eb-22ff-4937-a44a-13541434d4d2

		changedProperty = Name

	measure 'Departures with real-time' = SUM ( fct_departures[has_realtime] )
		formatString: 0
		lineageTag: 212913a5-cd18-4365-a13e-aa4e72c0c8fe

		changedProperty = Name

	measure 'Punctual departures' = SUM ( fct_departures[is_punctual] )
		formatString: 0
		lineageTag: dcd8216f-0dfd-4df3-ab75-860e75ef0aba

		changedProperty = Name

	/// Share of departures with real-time data that left less than 3 minutes late (measured at departure)
	measure 'On-time departures' = DIVIDE ( [Punctual departures], [Departures with real-time] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 95c4b7d6-db33-4ed6-bafd-cd7a4497aaaa

		changedProperty = Name

		changedProperty = FormatString

	/// Late departure rate, left empty when fewer than 30 departures with real-time data
	/// support it (small samples, e.g. night hours, swing with every single late train)
	measure 'Late departure rate (min. 30 trains)' = IF ( [Departures with real-time] >= 30, [Late departure rate] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 14768b56-57bc-469c-b2df-fe16e714ac8e

	measure 'Real-time coverage' = DIVIDE ( [Departures with real-time], [Departures] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: a7a1f81e-14ec-4637-b29d-4cce331b1010

		changedProperty = Name

		changedProperty = FormatString

	measure 'Average delay (min)' = AVERAGE ( fct_departures[delay_min] )
		lineageTag: c294b1b1-4e8f-4548-8977-64ad5597d278

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Share of departures with real-time data that left 3 minutes late or more
	measure 'Late departure rate' = DIVIDE ( [Departures with real-time] - [Punctual departures], [Departures with real-time] )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2f3a6991-c328-4e8d-aa47-017a68743dd8

