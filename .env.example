# Copy to .env and change the passwords. .env is git-ignored, never commit it.

# Oracle (container sm-oracle)
ORACLE_SYS_PASSWORD=ChangeMe_Sys_2026
ORACLE_APP_USER=mobility
ORACLE_APP_PASSWORD=ChangeMe_App_2026

# JupyterLab at http://localhost:8888 (enter this token)
JUPYTER_TOKEN=change-me

# dbt reads profiles.yml from the dbt project folder
DBT_PROFILES_DIR=/workspace/swiss-mobility-dbt
