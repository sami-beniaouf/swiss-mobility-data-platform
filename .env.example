# Copy to .env and change the passwords. .env is git-ignored, never commit it.

# Station hub used by the ingestion: local (Docker Oracle) or cloud (Autonomous Database)
ORACLE_TARGET=local

# Where bronze files and the station cache are written: local (data/ folder) or adls (Azure Data Lake Storage Gen2)
STORAGE_TARGET=local
ADLS_ACCOUNT_NAME=stswissmobility

# Oracle (container sm-oracle)
ORACLE_SYS_PASSWORD=ChangeMe_Sys_2026
ORACLE_APP_USER=mobility
ORACLE_APP_PASSWORD=ChangeMe_App_2026

# JupyterLab at http://localhost:8888 (enter this token)
JUPYTER_TOKEN=change-me

# dbt reads profiles.yml from the dbt project folder
DBT_PROFILES_DIR=/workspace/swiss-mobility-dbt

# Oracle Autonomous AI Database (cloud hub). The wallet is unzipped into secrets/oracle_wallet/ (git-ignored).
ORACLE_CLOUD_USER=mobility
ORACLE_CLOUD_PASSWORD=change-me
ORACLE_CLOUD_DSN=smhub_low
ORACLE_WALLET_DIR=/workspace/secrets/oracle_wallet
ORACLE_WALLET_PASSWORD=change-me