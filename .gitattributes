# Shell scripts run inside Linux containers: they MUST keep LF line endings,
# otherwise bash fails with "\r: command not found" when Git converts them on Windows.
*.sh text eol=lf
*.sql text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf

# Fabric workspace items are written by Fabric Git integration: keep them byte for byte as
# Fabric commits them (no line-ending conversion on checkout), so a pull from Fabric never
# shows files as modified on Windows.
fabric/** -text
